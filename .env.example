# ── Telegram-бот ────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=
# ID пользователей через запятую, кому разрешён бот. Пусто = первый, кто напишет боту /start, становится владельцем.
BOT_ALLOWED_USERS=

# ── ИИ ──────────────────────────────────────────────────────────
# Разбирает сложные посты (прайс-листы, «продам X, куплю Y»). Однозначные объявления и без него
# разбирают правила. Если ИИ недоступен (например, Ollama ещё не запущена), бот не падает: работает
# на правилах, а сложные посты дожидаются ИИ и разбираются позже.
# Проверить связь: docker compose exec lalascaner python -m lalascaner ai-check
AI_ENABLED=true

# ollama — Ollama у себя на Mac, БЕСПЛАТНО, рекомендуется (ответ жёстко ограничен JSON-схемой)
# openai — любой OpenAI-совместимый сервер: Groq (groq.com) или OpenRouter (openrouter.ai) с бесплатным тарифом
# claude — Anthropic API, платно, самый точный
AI_PROVIDER=ollama
# Имя модели. Для Ollama: qwen2.5:7b (хорошо понимает русский; нужно ~6 ГБ свободной памяти)
# или qwen2.5:3b (если на Mac 8 ГБ и 7b тормозит). Сначала скачать: ollama pull qwen2.5:7b
# Groq: llama-3.3-70b-versatile · OpenRouter: meta-llama/llama-3.1-8b-instruct:free · Claude: claude-opus-5 / claude-haiku-4-5
AI_MODEL=qwen2.5:7b
# Адрес сервера. Для Ollama оставьте пустым: в Docker это http://host.docker.internal:11434, без Docker — localhost.
# Groq: https://api.groq.com/openai/v1 · OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=
# Ключ провайдера: только для Groq/OpenRouter (AI_PROVIDER=openai). Ollama ключа не требует.
AI_API_KEY=not-needed
# Ключ Anthropic (только для AI_PROVIDER=claude): https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=

# hybrid — однозначные объявления разбирают правила, остальное ИИ (по умолчанию, если ИИ настроен)
# claude — всё через ИИ (название историческое, значит «только ИИ»); rules — вообще без ИИ
CLASSIFIER=
# Постов в одном запросе. Пусто = авто: 4 для локальных моделей, 10 для Claude.
AI_BATCH_SIZE=
# Сколько секунд ждать ответ модели на одну пачку (первая — дольше: модель загружается в память)
AI_TIMEOUT=300
# Размер контекста Ollama в токенах (промпт ~2,5 тыс. + пачка + ответ). Меньше 6000 ставить не стоит.
AI_NUM_CTX=8192
# Сколько дней назад опубликованные объявления lalafo ИИ ещё «дорабатывает» в фоне (посты Telegram — всегда).
# Старый хвост каталога остаётся на разборе правил — иначе слабый Mac считал бы сутками.
AI_REFINE_MAX_AGE_DAYS=3
AI_EFFORT=low
# Только для Claude: очередь больше этого числа уходит в Batch API (−50% стоимости, ответ в течение часа)
AI_BATCH_API_THRESHOLD=300

# ── Векторы (похожие, поиск по смыслу, перезаливы, «за сколько продать») ──
# Работают через ту же Ollama (AI_PROVIDER=ollama). Модель скачивается сама при первом запуске (~1.2 ГБ).
EMBED_ENABLED=true
EMBED_MODEL=bge-m3
EMBED_BATCH=32

# ── Источники ───────────────────────────────────────────────────
# lalafo читается всегда. Telegram-чаты/каналы — публичные, читаются без вступления бота: TELEGRAM_ENABLED=true
TELEGRAM_ENABLED=true
# Публичные Telegram-каналы и группы через запятую (без @). Добавлять можно и в боте: /addchannel
TELEGRAM_CHANNELS=compshop_kg
# Id тем форума, которые пропускаем целиком — там нет объявлений, только оффтоп/спам: 419 Правила,
# 4819 Blacklist, 6460 Болтовня, 6523, 6547 Ищу/Обмен. Узнать id темы: открыть её в Telegram →
# «⋮» → Копировать ссылку — число в конце ссылки.
TELEGRAM_BLOCKED_TOPICS=419,4819,6460,6523,6547
TELEGRAM_POLL_MINUTES=5
# Сколько истории загрузить при подключении: сообщений для групп, страниц (по 20 постов) для каналов
TELEGRAM_BACKFILL_MESSAGES=1500
TELEGRAM_BACKFILL_PAGES=10
LALAFO_POLL_MINUTES=10
# Полный обход всех страниц lalafo: так бот узнаёт, какие объявления ещё висят, а какие проданы/сняты
LALAFO_FULL_CRAWL_HOURS=6
# Объявление считается актуальным, если встречалось в ленте lalafo за последние N часов
LALAFO_ACTIVE_HOURS=14

# ── Сделки ──────────────────────────────────────────────────────
# cheapest — сделка, если объявление дешевле самого дешёвого АКТУАЛЬНОГО объявления той же модели
#            (RTX 3060 12GB) или той же версии (Palit Dual RTX 3060 12GB)
# median   — старый режим: на DEAL_THRESHOLD ниже медианы рынка
DEAL_MODE=cheapest
# Сколько актуальных объявлений должно быть для сравнения
DEAL_MIN_COMPETITORS=3
# Насколько дешевле самого дешёвого: не меньше N % и не меньше N сом (0 и 0 — хоть на сом дешевле)
DEAL_MIN_GAP_PERCENT=3
DEAL_MIN_GAP_KGS=0
# Уведомлять и о рекорде по версии (дешевле всех Palit Dual), а не только по модели целиком
DEAL_VARIANT_ALERTS=true
# Уведомления придерживаются, пока в очереди на разбор больше N объявлений (первая загрузка)
NOTIFY_WARMUP_PENDING=200

# ── Рынок ───────────────────────────────────────────────────────
# Окно, по которому считается медиана рынка (показывается для контекста)
STATS_WINDOW_DAYS=60
# Минимум предложений по модели, чтобы доверять медиане
MIN_SAMPLES=5
# Режим median: уведомлять, если цена на 20% ниже медианы и экономия не меньше суммы
DEAL_THRESHOLD=0.2
DEAL_MIN_SAVING_KGS=1500
# Цена ниже 35% медианы помечается как подозрительная (скам/ошибка)
SUSPICIOUS_RATIO=0.35
# Не уведомлять о постах старше N часов
NOTIFY_MAX_AGE_HOURS=48

# ── Прочее ──────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///data/lalascaner.db
LOG_LEVEL=INFO
